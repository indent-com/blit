# Copy to .env.local (loaded by .envrc via dotenv_if_exists).

# Browser passphrase for `blit gateway`; plaintext or `blit hash-passphrase` output.
BLIT_PASSPHRASE=changeme

# Force a single codec+encoder (default priority list in CONTRIBUTING.md):
# BLIT_SURFACE_ENCODERS=h264-vulkan
# BLIT_SURFACE_ENCODERS=av1-vulkan
# BLIT_SURFACE_ENCODERS=h264-nvenc
# BLIT_SURFACE_ENCODERS=av1-nvenc
# BLIT_SURFACE_ENCODERS=h264-vaapi
# BLIT_SURFACE_ENCODERS=av1-vaapi
# BLIT_SURFACE_ENCODERS=h264-software
# BLIT_SURFACE_ENCODERS=av1-software
