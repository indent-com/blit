{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Blit muster unit, stack or instance",
  "type": "object",
  "properties": {
    "$schema": { "type": "string" },
    "//": { "description": "Prose. JSON has no comments." },

    "description": { "type": "string" },
    "autostart": { "type": "boolean", "default": true },
    "requires": { "type": "array", "items": { "type": "string" } },
    "wants": { "type": "array", "items": { "type": "string" } },
    "after": { "type": "array", "items": { "type": "string" } },

    "command": {
      "description": "An argv, exec'd directly. No shell, no rc files, no shell syntax.",
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "shell": {
      "description": "A command line for the server's login shell. Excludes command.",
      "type": "string"
    },
    "cwd": {
      "description": "Working directory. Relative paths in stack templates resolve from STACK_DIR.",
      "type": "string"
    },
    "env": { "type": "object", "additionalProperties": { "type": "string" } },
    "envFile": {
      "oneOf": [
        { "type": "string" },
        {
          "type": "array",
          "items": {
            "oneOf": [
              { "type": "string" },
              {
                "type": "object",
                "properties": {
                  "path": { "type": "string" },
                  "optional": { "type": "boolean" }
                },
                "required": ["path"],
                "additionalProperties": false
              }
            ]
          }
        }
      ]
    },
    "type": { "enum": ["simple", "oneshot"], "default": "simple" },
    "readyWhen": {
      "oneOf": [
        { "enum": ["spawn", "manual"] },
        {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 1,
          "properties": {
            "delay": { "type": ["string", "integer"] },
            "path": { "type": "string" },
            "log": { "type": "string" },
            "tcp": { "type": "string" },
            "http": { "type": "string" }
          },
          "additionalProperties": false
        }
      ]
    },

    "restartOnFailure": { "type": "boolean", "default": true },
    "restartOnSuccess": { "type": "boolean", "default": false },
    "restartOnAbnormal": {
      "description": "Restart when the process was killed by a signal, as opposed to choosing an exit code.",
      "type": "boolean",
      "default": true
    },
    "restartOnChange": { "type": "boolean", "default": true },
    "restartDelay": { "type": ["string", "integer"] },
    "keep": { "type": "integer", "minimum": 0, "default": 1 },
    "timeoutStart": { "type": ["string", "integer"], "default": "30s" },
    "stopSignal": { "type": "string", "default": "SIGTERM" },
    "stopCommand": {
      "description": "Run this instead of signalling, for a program that is a handle on something else. The signal still comes after timeoutStop.",
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "reloadCommand": {
      "description": "Run this for `@muster reload <name>`. Without one, reloading a unit restarts it.",
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "timeoutStop": { "type": ["string", "integer"], "default": "10s" },
    "startLimit": { "type": "integer", "minimum": 0, "default": 5 },

    "stack": {
      "description": "For an instance, a subdirectory name or path. With worktrees, a repository-relative stack path.",
      "type": "string"
    },
    "worktrees": {
      "description": "Path to a repository's main worktree. With stack, derives one instance per Git worktree.",
      "type": "string"
    },
    "include": {
      "description": "Names a directory of ordinary units. Their names are not suffixed.",
      "type": "string"
    },
    "vars": { "type": "object" },
    "omit": { "type": "array", "items": { "type": "string" } }
  },
  "allOf": [
    {
      "if": { "required": ["command"] },
      "then": { "not": { "required": ["shell"] } }
    },
    {
      "if": { "required": ["worktrees"] },
      "then": {
        "required": ["stack"],
        "not": { "required": ["include"] }
      }
    },
    {
      "if": {
        "not": {
          "anyOf": [
            { "required": ["stack"] },
            { "required": ["include"] },
            { "required": ["worktrees"] }
          ]
        }
      },
      "then": {
        "anyOf": [{ "required": ["command"] }, { "required": ["shell"] }]
      }
    }
  ]
}
