---
import CopyButton from "./CopyButton.tsx";
import HeroWorkspace from "./HeroWorkspace.tsx";

const INSTALL_CMD = "curl -sf https://install.blit.sh | sh";
const INSTALL_PS = "irm https://install.blit.sh/install.ps1 | iex";
const OPEN_CMD = "blit open";
const DOCKER_CMD = "docker run --rm --shm-size=1g grab/blit-demo";

const INSTALL_ROWS = [
  { platform: "Linux / macOS", prompt: "$", command: INSTALL_CMD },
  { platform: "Windows", prompt: ">", command: INSTALL_PS },
];

const PROOF = [
  { value: "1", label: "binary" },
  { value: "0", label: "required dependencies" },
  { value: "3", label: "desktop platforms" },
  { value: "MIT", label: "open-source core" },
];
---

<section
  id="install"
  class="relative isolate overflow-hidden border-b border-[var(--border)] hero-bg"
>
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 grid-bg"></div>

  <div class="relative mx-auto max-w-6xl px-6 pb-16 pt-14 max-sm:px-4 max-sm:pb-12 max-sm:pt-10 lg:pb-20 lg:pt-18">
    <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-[minmax(0,0.92fr)_minmax(0,1.08fr)] lg:gap-10">
      <div class="flex flex-col">
        <div class="mb-5 flex flex-wrap items-center gap-2">
          <span class="rounded-full border border-[var(--accent)]/35 bg-[var(--accent-soft)] px-3 py-1 font-mono text-[10px] font-bold uppercase tracking-[0.14em] text-[var(--accent)]">
            Open-source remote workspace
          </span>
          <span class="font-mono text-[10px] text-[var(--dim)]">Linux · macOS · Windows</span>
        </div>

        <h1 class="font-sans text-[clamp(2.7rem,5.8vw,4.6rem)] font-bold leading-[0.99] tracking-[-0.045em] text-[var(--bright)]">
          Your whole dev machine.
          <span class="grad-text">One browser tab.</span>
        </h1>

        <p class="mt-6 max-w-xl text-[17px] leading-[1.7] text-[var(--dim)]">
          Blit turns any machine into a fast browser workspace—with persistent
          terminals, files, Git, code intelligence, port forwarding, and even
          GUI apps. Share it with a link. Drive it with an agent.
        </p>

        <div class="mt-8 max-w-xl overflow-hidden rounded-xl border border-[var(--border-strong)] bg-[var(--bg-elevated)] shadow-[0_12px_32px_-22px_var(--accent-glow)]">
          <div class="flex items-center justify-between border-b border-[var(--border)] bg-[var(--surface)] px-4 py-2.5">
            <span class="font-mono text-[10px] font-bold uppercase tracking-[0.14em] text-[var(--dim)]">Install and open</span>
            <span class="font-mono text-[10px] text-[var(--green)]">about 3 seconds</span>
          </div>
          <div class="divide-y divide-[var(--border)]">
            {
              INSTALL_ROWS.map(({ platform, prompt, command }) => (
                <div class="px-4 py-3.5">
                  <div class="font-mono text-[9px] font-bold uppercase tracking-wider text-[var(--dim)]">
                    {platform}
                  </div>
                  <div class="mt-1.5 flex min-w-0 items-start gap-2">
                    <span class="select-none text-[var(--green)]">{prompt}</span>
                    <code class="min-w-0 flex-1 break-all font-mono text-[12px] leading-relaxed text-[var(--code-fg)] sm:break-normal">
                      {command}
                    </code>
                    <CopyButton text={command} client:load />
                  </div>
                </div>
              ))
            }
          </div>
          <div class="flex items-center gap-3 border-t border-[var(--border)] bg-[var(--surface)] px-4 py-2.5 text-[11px] text-[var(--dim)]">
            <span class="min-w-0 flex-1">
              Both install one binary. Then run
              <code class="font-bold text-[var(--fg)]">{OPEN_CMD}</code>.
            </span>
            <CopyButton text={OPEN_CMD} client:load />
          </div>
        </div>

        <div class="mt-5 flex flex-wrap items-center gap-4">
          <a href="#product" class="inline-flex items-center gap-2 rounded-lg bg-[var(--bright)] px-4 py-2.5 text-[13px] font-semibold text-[var(--bg)] no-underline transition-transform hover:-translate-y-0.5">
            See everything Blit does
            <span aria-hidden="true">↓</span>
          </a>
          <a href="https://github.com/indent-com/blit" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-[13px] font-semibold text-[var(--fg)] no-underline hover:text-[var(--accent)]">
            View on GitHub <span aria-hidden="true">↗</span>
          </a>
        </div>

        <div class="mt-7 max-w-xl rounded-lg border border-dashed border-[var(--border-strong)] px-3.5 py-3">
          <div class="font-mono text-[9px] font-bold uppercase tracking-wider text-[var(--dim)]">No install · Docker demo</div>
          <div class="mt-1.5 flex min-w-0 items-start gap-2">
            <span class="select-none text-[var(--green)]">$</span>
            <code class="min-w-0 flex-1 break-all font-mono text-[11px] leading-relaxed text-[var(--fg)] sm:break-normal">{DOCKER_CMD}</code>
            <CopyButton text={DOCKER_CMD} client:load />
          </div>
        </div>
      </div>

      <div class="relative">
        <div aria-hidden="true" class="pointer-events-none absolute -inset-6 -z-10 rounded-[28px] opacity-70 blur-2xl" style="background: radial-gradient(40rem 18rem at 60% 40%, var(--accent-glow), transparent 70%);"></div>
        <div class="mb-3 flex items-center justify-between px-1 font-mono text-[10px] uppercase tracking-[0.12em] text-[var(--dim)]">
          <span>The actual Blit workspace</span>
          <span class="flex items-center gap-1.5 text-[var(--green)]"><span class="h-1.5 w-1.5 rounded-full bg-[var(--green)]"></span> Real recorded session</span>
        </div>
        <HeroWorkspace client:only="solid-js" />
      </div>
    </div>

    <dl class="mt-14 grid grid-cols-2 overflow-hidden rounded-xl border border-[var(--border)] bg-[color-mix(in_oklab,var(--bg-elevated)_82%,transparent)] backdrop-blur sm:grid-cols-4">
      {
        PROOF.map(({ value, label }, i) => (
          <div class:list={["px-5 py-4", i % 2 === 0 && "max-sm:border-r max-sm:border-[var(--border)]", i < 2 && "max-sm:border-b max-sm:border-[var(--border)]", i < PROOF.length - 1 && "sm:border-r sm:border-[var(--border)]"]}>
            <dt class="font-mono text-[20px] font-bold leading-none text-[var(--bright)]">{value}</dt>
            <dd class="mt-1.5 font-mono text-[9px] font-bold uppercase tracking-[0.14em] text-[var(--dim)]">{label}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
