---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import ProductTour from "../components/ProductTour.astro";
import HowItWorks from "../components/HowItWorks.astro";
import Comparison from "../components/Comparison.astro";
import KnownLimitationsSection from "../components/KnownLimitationsSection.astro";
import CTA from "../components/CTA.astro";
import Footer from "../components/Footer.astro";
---

<Layout>
  <div class="flex min-h-screen flex-col bg-[var(--bg)]">
    <Header />
    <main class="flex-1">
      <Hero />
      <ProductTour />
      <div id="how"><HowItWorks /></div>
      <div id="compare"><Comparison /></div>
      <KnownLimitationsSection />
      <CTA />
    </main>
    <Footer />
  </div>
</Layout>
